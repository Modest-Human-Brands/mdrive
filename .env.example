# System
PORT=3004
NODE_ENV=development

# Shared (Unprefixed)
# Notion (shared)
NOTION_API_KEY=
NOTION_DB_ID=
CONCURRENCY_LIMIT=2

# Scoped Service
# JSON map of database ids: {"organization":"","contact":"","project":"","media":""}
# Microservice Endpoints
NITRO_MDRIVE_PUBLIC_MEDIA_URL=http://localhost:3004
# MMedia (transform service) and its shared key
NITRO_MDRIVE_PRIVATE_MMEDIA_URL=http://localhost:3111
NITRO_MDRIVE_PRIVATE_MMEDIA_API_KEY=
# Optional: Notion API origin override (test stub only)
NOTION_API_BASE_URL=
NITRO_MDRIVE_PRIVATE_MCONNECT_URL=http://localhost:3001
NITRO_MDRIVE_PRIVATE_MEDIA_REDIRECT_URL=
NITRO_MDRIVE_PRIVATE_SERVER_VALIDATION_KEY=
NITRO_MDRIVE_PRIVATE_STEGANOGRAPHY_KEY=
# Cloudflare R2 - CDN / Cache Storage
NITRO_MDRIVE_PRIVATE_CDN_R2_ACCESS_KEY_ID=
NITRO_MDRIVE_PRIVATE_CDN_R2_SECRET_ACCESS_KEY=
NITRO_MDRIVE_PRIVATE_CDN_R2_ENDPOINT=
NITRO_MDRIVE_PRIVATE_CDN_R2_BUCKET=
NITRO_MDRIVE_PRIVATE_CDN_R2_REGION=auto
# Cloudflare R2 - Drive / Origin Storage
NITRO_MDRIVE_PRIVATE_DRIVE_R2_ACCESS_KEY_ID=
NITRO_MDRIVE_PRIVATE_DRIVE_R2_SECRET_ACCESS_KEY=
NITRO_MDRIVE_PRIVATE_DRIVE_R2_ENDPOINT=
NITRO_MDRIVE_PRIVATE_DRIVE_R2_BUCKET=
NITRO_MDRIVE_PRIVATE_DRIVE_R2_REGION=auto
